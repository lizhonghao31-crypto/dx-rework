# Acceptance/UAT shared-path locations for the existing staging HTTPS vhost.
# Install this file as /etc/nginx/dx-rework-acceptance.locations only during
# an approved infrastructure window. It must be included by the existing
# staging-api.dxerp.org.cn server block. Routine releases never reload Nginx.

location = /acceptance {
    return 308 /acceptance/ui/acceptance-lab;
}

location ^~ /acceptance/api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:3202/;
}

location ^~ /acceptance/assets/ {
    alias /opt/dx-rework-acceptance/frontend/current/assets/;
    try_files $uri =404;
}

location = /acceptance/index.html {
    alias /opt/dx-rework-acceptance/frontend/current/index.html;
    add_header Cache-Control "no-store";
}

location ^~ /acceptance/ui/ {
    rewrite ^ /acceptance/index.html last;
}
