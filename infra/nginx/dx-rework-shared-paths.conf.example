# Include these location blocks inside the existing staging HTTPS server {} only.
# Do not create a second server_name for staging-api.dxerp.org.cn.
# The http {} layer must already define the dx_rework_query_free log format.
# Routine dx-rework releases never reload Nginx.

# DX_REWORK_SHARED_PATHS_BEGIN
location = /rework {
    if (-f /opt/dx-rework/shared/release-switch.lock) { return 503; }
    access_log /opt/dx-rework/logs/nginx-access.log dx_rework_query_free;
    return 308 /rework/;
}

# DingTalk redirects the embedded frame here with authCode/state in the query.
# Suppress the request line entirely on this credential-bearing endpoint.
location = /rework/auth/qr/relay {
    if (-f /opt/dx-rework/shared/release-switch.lock) { return 503; }
    access_log off;
    error_log /dev/null emerg;
    alias /opt/dx-rework/frontend/current/index.html;
}

# Legacy callback compatibility. Keep OAuth query material out of Nginx logs.
location = /rework/api/auth/qr/callback {
    if (-f /opt/dx-rework/shared/release-switch.lock) { return 503; }
    access_log off;
    error_log /dev/null emerg;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:3201/auth/qr/callback;
}

# All public API traffic stays under /rework/api/. The trailing slash strips
# the public prefix before forwarding to the isolated API listener.
location ^~ /rework/api/ {
    if (-f /opt/dx-rework/shared/release-switch.lock) { return 503; }
    access_log /opt/dx-rework/logs/nginx-access.log dx_rework_query_free;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_pass http://127.0.0.1:3201/;
}

# Vite emits /rework/assets/*; rewrite only inside this dx-rework location,
# then resolve against the immutable frontend current alias. Missing assets
# stay a plain 404 and never fall back to SPA HTML.
location ^~ /rework/assets/ {
    if (-f /opt/dx-rework/shared/release-switch.lock) { return 503; }
    access_log /opt/dx-rework/logs/nginx-access.log dx_rework_query_free;
    rewrite ^/rework/(.*)$ /$1 break;
    root /opt/dx-rework/frontend/current;
    try_files $uri =404;
}

# SPA shell and deep links. The fallback deliberately stays under /rework/ so
# the internal redirect cannot escape into an unrelated shared-origin root.
location ^~ /rework/ {
    if (-f /opt/dx-rework/shared/release-switch.lock) { return 503; }
    access_log /opt/dx-rework/logs/nginx-access.log dx_rework_query_free;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    rewrite ^/rework/(.*)$ /$1 break;
    root /opt/dx-rework/frontend/current;
    try_files $uri $uri/ /rework/index.html;
}
# DX_REWORK_SHARED_PATHS_END
