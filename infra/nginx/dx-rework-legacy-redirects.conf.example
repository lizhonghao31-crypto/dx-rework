# Include inside the legacy staging HTTPS server after OPS-05.
# The official production application lives at https://dxerp.org.cn/.
# Keep the acceptance locations separate; this snippet only migrates /rework.
location = /rework {
    return 308 https://dxerp.org.cn/;
}

# OAuth-bearing legacy URLs must never write the request line to Nginx logs.
location = /rework/auth/qr/relay {
    access_log off;
    error_log /dev/null emerg;
    return 308 https://dxerp.org.cn/auth/qr/relay$is_args$args;
}

location = /rework/api/auth/qr/callback {
    access_log off;
    error_log /dev/null emerg;
    return 308 https://dxerp.org.cn/api/auth/qr/callback$is_args$args;
}

# Preserve old deep links while removing the historical /rework prefix.
location ~ ^/rework/(?<dx_rework_legacy_path>.*)$ {
    return 308 https://dxerp.org.cn/$dx_rework_legacy_path$is_args$args;
}
