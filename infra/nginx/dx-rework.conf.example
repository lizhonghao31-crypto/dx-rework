# 本文件应由 Nginx 的 http 层 include；格式不记录 query string 或 Referer。
log_format dx_rework_query_free '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                                '$status $body_bytes_sent $request_time "$request_id"';

# 独立 vhost 示例。PR-01 不安装、不 reload Nginx，也不修改 ERP 配置。
server {
    listen 80;
    # Render DX_REWORK_SERVER_NAME and DX_REWORK_TLS_* during installation.
    # Any remaining double-underscore token is rejected by preflight.
    server_name __DX_REWORK_SERVER_NAME__;

    root /opt/dx-rework/frontend/current;
    index index.html;

    access_log /opt/dx-rework/logs/nginx-access.log dx_rework_query_free;
    error_log  /opt/dx-rework/logs/nginx-error.log warn;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json text/css text/plain;

    location = /health/live {
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/health/live;
    }

    location = /health/ready {
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/health/ready;
    }

    location = /version {
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/version;
    }

    # OAuth callback request lines contain credentials. Suppress Nginx error
    # diagnostics for only these exact locations; Fastify retains sanitized logs.
    location = /api/auth/qr/callback {
        error_log /dev/null emerg;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/auth/qr/callback;
    }

    location = /rework/api/auth/qr/callback {
        error_log /dev/null emerg;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/auth/qr/callback;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/;
    }

    # Prefixed deployment: strip /rework/api/ before forwarding to the API.
    location ^~ /rework/api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_pass http://127.0.0.1:3201/;
    }

    # Vite emits /rework/assets/* URLs, while the artifact stores files in assets/*.
    # alias strips the public prefix; missing assets return 404 and never the SPA HTML.
    location ^~ /rework/assets/ {
        alias /opt/dx-rework/frontend/current/assets/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
