# Acceptance/UAT only. Copy to /opt/dx-rework-acceptance/shared/.env,
# keep mode 0600, replace every placeholder locally, and never reuse production secrets.
DATABASE_URL=postgresql://acceptance_user:REPLACE@127.0.0.1:5432/dx_rework_acceptance
LOG_LEVEL=info
DINGTALK_CORP_ID=corp-acceptance
DINGTALK_H5_APP_KEY=acceptance-disabled
DINGTALK_H5_APP_SECRET=acceptance-disabled
DINGTALK_WEB_CLIENT_ID=acceptance-disabled
DINGTALK_WEB_CLIENT_SECRET=acceptance-disabled
DINGTALK_QR_REDIRECT_URI=https://acceptance.invalid/auth/qr/callback
APP_BASE_PATH=/
SESSION_SECRET=REPLACE_WITH_ACCEPTANCE_ONLY_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=28800
ROOT_DINGTALK_USER_ID=uat-root
ACCEPTANCE_LAB_ENABLED=true
ACCEPTANCE_LAB_SECRET=REPLACE_WITH_ACCEPTANCE_LAB_SECRET_AT_LEAST_32_CHARS
TODO_RUNTIME_ENABLED=false
TODO_DELIVERY_ENABLED=false
TODO_TIMING_ENABLED=false
