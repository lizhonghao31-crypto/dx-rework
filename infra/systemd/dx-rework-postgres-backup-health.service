[Unit]
Description=Verify DX Rework daily PostgreSQL backup health
After=dx-rework-postgres-backup.service

[Service]
Type=oneshot
User=dxrework
Group=dxrework
UMask=0077
ExecStart=/opt/dx-rework/current/scripts/deploy/check-scheduled-postgres-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
