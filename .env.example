# 仅保存变量名和非敏感本地默认值；真实值由部署环境注入。
NODE_ENV=development
HOST=127.0.0.1
PORT=3201
DATABASE_URL=postgresql://dx_rework:replace_me@127.0.0.1:5432/dx_rework
LOG_LEVEL=info
GIT_SHA=local
BUILD_TIME=local
SERVICE_NAME=dx-rework-api
DINGTALK_CORP_ID=replace_with_company_corp_id
DINGTALK_H5_APP_KEY=replace_with_h5_app_key
DINGTALK_H5_APP_SECRET=replace_with_h5_app_secret
DINGTALK_WEB_CLIENT_ID=replace_with_web_oauth_client_id
DINGTALK_WEB_CLIENT_SECRET=replace_with_web_oauth_client_secret
# 网页扫码登录回到同源前端中继页，再由父窗口通过一次性 state + HttpOnly 绑定 Cookie 完成登录。
DINGTALK_QR_REDIRECT_URI=https://replace.example/rework/auth/qr/relay
APP_BASE_PATH=/
VITE_BASE_PATH=/
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_TTL_SECONDS=28800
# Root 超级用户身份由部署环境私有绑定钉钉 UserID；真实值禁止提交仓库。
# ROOT_DINGTALK_USER_ID=
# 首位老板 bootstrap 默认关闭；仅在一次性初始化窗口由部署环境同时注入两项，禁止写入前端或仓库真实值。
# OWNER_BOOTSTRAP_DINGTALK_USER_ID=
# OWNER_BOOTSTRAP_SECRET=
TODO_RUNTIME_ENABLED=false
# TODO_RUNTIME_ACTOR_ID=
TODO_DELIVERY_INTERVAL_MS=30000
TODO_TIMING_INTERVAL_MS=60000
# 私有 OSS；要么整组不配置（API 明确返回 503），要么由部署环境完整注入。
# OSS_REGION=
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
OSS_PRIVATE_PREFIX=dx-rework/private
OSS_SIGNED_URL_TTL_SECONDS=300
OSS_MAX_UPLOAD_BYTES=20971520