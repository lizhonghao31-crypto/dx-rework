# Copy to /opt/dx-rework/shared/deploy.env on the target host.
# Owner: the dedicated low-privilege deployment user. Mode: 0600.
# Do not place application secrets or restore credentials in this file.
#
# Production official-domain contract (OPS-05): dxerp.org.cn owns the root
# application and uses the dedicated vhost. TLS/config paths below are the
# current production convention and must still be verified on the target host.
DX_REWORK_NODE_BIN=/opt/node-v22/bin/node
DX_REWORK_NGINX_MODE=dedicated_vhost
DX_REWORK_SERVER_NAME=dxerp.org.cn
DX_REWORK_TLS_CERT=/etc/letsencrypt/live/dxerp.org.cn/fullchain.pem
DX_REWORK_TLS_KEY=/etc/letsencrypt/live/dxerp.org.cn/privkey.pem
DX_REWORK_NGINX_CONFIG=/etc/nginx/conf.d/dxerp-official.conf
DX_REWORK_PROFILE=production

# Pilot remains a supported prefixed deployment. For a pilot host use:
# DX_REWORK_NGINX_MODE=shared_path
# DX_REWORK_SERVER_NAME=staging-api.dxerp.org.cn
# DX_REWORK_TLS_CERT=/REPLACE_WITH_EXISTING_STAGING_CERT/fullchain.pem
# DX_REWORK_TLS_KEY=/REPLACE_WITH_EXISTING_STAGING_CERT/privkey.pem
# DX_REWORK_NGINX_CONFIG=/REPLACE_WITH_EXISTING_STAGING_VHOST.conf
# DX_REWORK_PROFILE=pilot
