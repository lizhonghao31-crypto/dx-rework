# Copy to /opt/dx-rework/shared/deploy.env on the target host.
# Owner: the dedicated low-privilege deployment user. Mode: 0600.
# Do not place application secrets or restore credentials in this file.
#
# Confirmed pilot mode: reuse the existing dxerp staging origin/certificate and
# isolate dx-rework under /rework/. The three filesystem paths below are
# intentionally placeholders: replace them only with values read from the
# target host/current Nginx configuration; do not guess them from this example.
DX_REWORK_NODE_BIN=/opt/node-v22/bin/node
DX_REWORK_NGINX_MODE=shared_path
DX_REWORK_SERVER_NAME=staging-api.dxerp.org.cn
DX_REWORK_TLS_CERT=/REPLACE_WITH_EXISTING_DXERP_CERT/fullchain.pem
DX_REWORK_TLS_KEY=/REPLACE_WITH_EXISTING_DXERP_CERT/privkey.pem
DX_REWORK_NGINX_CONFIG=/REPLACE_WITH_EXISTING_STAGING_VHOST.conf
DX_REWORK_PROFILE=pilot

# Dedicated-vhost compatibility remains supported for a future environment.
# If used, set DX_REWORK_NGINX_MODE=dedicated_vhost and provide that vhost's
# independent server_name/TLS/config paths instead. Do not infer mode from host.
