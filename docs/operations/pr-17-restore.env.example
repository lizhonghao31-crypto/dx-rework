# Copy to /opt/dx-rework/shared/restore.env only for an approved restore drill.
# Owner: the dedicated low-privilege deployment user. Mode: 0600.
# This file is read only by restore-postgres.sh and is never loaded by the API.
DX_REWORK_RESTORE_DATABASE_URL=postgresql://restore_user:replace_me@127.0.0.1:5432/dx_rework_drill_example
DX_REWORK_APPROVED_TARGET_FINGERPRINT=replace_with_sha256_of_server_port_database_identity
DX_REWORK_APPROVED_TARGET_DATABASE=dx_rework_drill_example
