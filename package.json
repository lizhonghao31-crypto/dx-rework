{
  "name": "dx-rework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "达兴内部计件返工系统独立技术基座",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "packages/contracts",
    "packages/config",
    "packages/domain",
    "packages/ui",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "predev:api": "npm run build:packages",
    "dev:api": "npm run dev --workspace @dx-rework/api",
    "predev:web": "npm run build:packages",
    "dev:web": "npm run dev --workspace @dx-rework/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:packages": "npm run build --workspace @dx-rework/contracts && npm run build --workspace @dx-rework/config && npm run build --workspace @dx-rework/domain && npm run build --workspace @dx-rework/ui",
    "pretest": "npm run build:packages",
    "test": "vitest run",
    "pretest:unit": "npm run build:packages",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "npm run build:packages",
    "test:integration": "vitest run tests/integration",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:lint": "node scripts/check-migrations.mjs",
    "db:migrate:check": "node scripts/migration-integration-check.mjs",
    "todos:backfill": "npm run build:packages && npm run build --workspace @dx-rework/api && node scripts/todos-backfill.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test && npm run db:migrate:lint && npm run secret:scan",
    "preview:dry-run": "bash scripts/preview/dry-run.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.3",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
