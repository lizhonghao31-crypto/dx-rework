{
  "name": "dx-rework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\u8fbe\u5174\u5185\u90e8\u8ba1\u4ef6\u8fd4\u5de5\u7cfb\u7edf\u72ec\u7acb\u6280\u672f\u57fa\u5ea7",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "packages/contracts",
    "packages/config",
    "packages/domain",
    "packages/ui",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "predev:api": "npm run build:packages",
    "dev:api": "npm run dev --workspace @dx-rework/api",
    "predev:web": "npm run build:packages",
    "dev:web": "npm run dev --workspace @dx-rework/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:packages": "npm run build --workspace @dx-rework/contracts && npm run build --workspace @dx-rework/config && npm run build --workspace @dx-rework/domain && npm run build --workspace @dx-rework/ui",
    "pretest": "npm run build:packages",
    "test": "vitest run",
    "pretest:unit": "npm run build:packages",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "npm run build:packages",
    "test:integration": "vitest run tests/integration",
    "build": "npm run build --workspaces --if-present",
    "postbuild": "node scripts/run-business-chain-gate.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:lint": "node scripts/check-migrations.mjs",
    "db:migrate:check": "node scripts/migration-integration-check.mjs",
    "secret:scan": "node scripts/secret-scan.mjs --worktree",
    "secret:scan:full": "node scripts/secret-scan.mjs --all",
    "check": "npm run test:preflight && npm run lint && npm run typecheck && npm run build --workspaces --if-present && node node_modules/vitest/vitest.mjs run && node scripts/run-business-chain-gate.mjs --static-already-validated && npm run secret:scan",
    "preview:dry-run": "bash scripts/preview/dry-run.sh",
    "pr17:acceptance": "node scripts/acceptance/validate.mjs docs/operations/pr-17-acceptance-matrix.json",
    "test:preflight": "node scripts/test-preflight.mjs",
    "test:postgres": "node scripts/run-business-chain-gate.mjs --full-gate",
    "test:plan": "node --input-type=module -e 'import {postgresPlan} from \"./scripts/test-suite-plan.mjs\"; console.log(JSON.stringify(postgresPlan({rootAudit:process.env.MIGRATION_SENSITIVE===\"true\",mapped:(process.env.MAPPED_POSTGRES_TESTS||\"\").split(\",\").filter(Boolean),chain:process.env.BUSINESS_CHAIN_SENSITIVE===\"true\"||process.env.MIGRATION_SENSITIVE===\"true\"||process.env.DEPLOYMENT_SENSITIVE===\"true\"}),null,2))'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.20.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.20.3",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "pdfjs-dist": "6.3.289",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
