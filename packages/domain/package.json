{
  "name": "@dx-rework/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./production-period": { "types": "./src/production-period.ts", "import": "./dist/production-period.js" },
    "./production-statistics": { "types": "./src/production-statistics.ts", "import": "./dist/production-statistics.js" },
    "./sla-calculation-routes": { "types": "./src/sla-calculation-routes.ts", "import": "./dist/sla-calculation-routes.js" },
    "./sla-calculation": { "types": "./src/sla-calculation.ts", "import": "./dist/sla-calculation.js" },
    "./series-plan": { "types": "./src/series-plan.ts", "import": "./dist/series-plan.js" },
    "./development-cycle": { "types": "./src/development-cycle.ts", "import": "./dist/development-cycle.js" },
    "./business-clock": { "types": "./src/business-clock.ts", "import": "./dist/business-clock.js" },
    "./digital-sla-plan": { "types": "./src/digital-sla-plan.ts", "import": "./dist/digital-sla-plan.js" },
    "./digital-task-deadline": { "types": "./src/digital-task-deadline.ts", "import": "./dist/digital-task-deadline.js" },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
